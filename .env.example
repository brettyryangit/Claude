# App
APP_NAME=Grit
DEBUG=false
SECRET_KEY=your-secret-key-here

# Database (auto-provided by Railway)
DATABASE_URL=postgresql://user:password@host:5432/grit

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp / Meta (Meta Business Suite → WhatsApp Manager)
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=grit-verify-token-change-this

# Stripe (dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CORE=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...
STRIPE_PRICE_ANNUAL=price_...

# Cloudflare R2 (dash.cloudflare.com → R2)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-access-key
CLOUDFLARE_R2_SECRET_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET=grit-assets
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
