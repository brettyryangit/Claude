# Copy to .env for local dev (`supabase functions serve --env-file .env`).
# For deployment, set these as function secrets:
#   supabase secrets set --env-file .env

# --- Anthropic (AI layer) --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model to tune per-message cost (default claude-opus-4-8).
# e.g. claude-haiku-4-5 for high-volume / cheaper check-in copy.
ANTHROPIC_MODEL=claude-opus-4-8

# --- WhatsApp BSP (Twilio) -------------------------------------------------
# Twilio sandbox: https://www.twilio.com/docs/whatsapp/sandbox
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Supabase --------------------------------------------------------------
# Injected automatically in deployed functions; set these only for local dev.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=...

# --- Behaviour knobs -------------------------------------------------------
DEFAULT_TIMEZONE=Australia/Perth
TRIAL_DAYS=7
CHECKIN_MAX_NUDGES=2
NUDGE_GAP_HOURS=4
MISS_CUTOFF_HOURS=24

# v1 access gate. Keep 'true' for the friends pilot; set 'false' to open up.
ALLOWLIST_ENABLED=true

# Shared secret protecting the cron-triggered functions.
CRON_SECRET=change-me-to-a-long-random-string
