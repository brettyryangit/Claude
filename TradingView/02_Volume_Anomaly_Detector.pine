//@version=5
indicator("Volume Anomaly Detector", overlay=false)

// ── Inputs ────────────────────────────────────────────────────────────────────
volMaLen   = input.int(20,  "Volume MA Length",      minval=5)
thresh1    = input.float(1.5, "Alert Level 1 (yellow)", step=0.1, minval=1.0)
thresh2    = input.float(2.0, "Alert Level 2 (orange)", step=0.1, minval=1.0)
thresh3    = input.float(3.0, "Alert Level 3 (red)",    step=0.1, minval=1.0)
showLabels = input.bool(true, "Show Volume Ratio Labels")

// ── Calculations ──────────────────────────────────────────────────────────────
volMA  = ta.sma(volume, volMaLen)
volRat = volMA > 0 ? volume / volMA : 1.0

// Spike levels
isLevel1 = volRat >= thresh1 and volRat < thresh2
isLevel2 = volRat >= thresh2 and volRat < thresh3
isLevel3 = volRat >= thresh3

// Bar color
barColor = isLevel3 ? color.new(color.red,    0) :
           isLevel2 ? color.new(color.orange, 0) :
           isLevel1 ? color.new(color.yellow, 0) :
           close >= open ? color.new(color.teal, 30) : color.new(color.maroon, 30)

// ── Plots ─────────────────────────────────────────────────────────────────────
plot(volume, "Volume",    color=barColor, style=plot.style_columns)
plot(volMA,  "Vol MA",    color=color.new(color.white, 40), linewidth=2)
plot(volMA * thresh1,     "Level 1", color=color.new(color.yellow, 60), linewidth=1, style=plot.style_line)
plot(volMA * thresh2,     "Level 2", color=color.new(color.orange, 60), linewidth=1, style=plot.style_line)
plot(volMA * thresh3,     "Level 3", color=color.new(color.red,    60), linewidth=1, style=plot.style_line)

// Ratio labels on spike bars
if showLabels and (isLevel1 or isLevel2 or isLevel3)
    labelColor = isLevel3 ? color.red : isLevel2 ? color.orange : color.yellow
    label.new(bar_index, volume,
              str.tostring(math.round(volRat, 1)) + "×",
              style=label.style_label_down,
              color=labelColor,
              textcolor=color.black,
              size=size.small)

// ── Alert conditions ──────────────────────────────────────────────────────────
alertcondition(isLevel1, "Volume Spike 1.5×", "Volume spike: {{ticker}} volume is {{plot_0}} ({{plot_1}}×)")
alertcondition(isLevel2, "Volume Spike 2×",   "Volume spike 2×: {{ticker}} — high institutional interest")
alertcondition(isLevel3, "Volume Spike 3×",   "EXTREME volume: {{ticker}} — potential major move")

// Spike on a bullish bar is the cleanest accumulation signal
bullAccum = isLevel2 and close > open and close > ta.ema(close, 20)
bearDist  = isLevel2 and close < open and close < ta.ema(close, 20)
alertcondition(bullAccum, "Bullish Accumulation", "Bullish accumulation spike: {{ticker}}")
alertcondition(bearDist,  "Bearish Distribution", "Bearish distribution spike: {{ticker}}")

// ── Info label (top right of pane) ───────────────────────────────────────────
if barstate.islast
    infoTxt = "VOL RATIO: " + str.tostring(math.round(volRat, 2)) + "×\n" +
              "VOL MA(" + str.tostring(volMaLen) + "): " + str.tostring(math.round(volMA / 1000, 0)) + "K"
    infoColor = isLevel3 ? color.red : isLevel2 ? color.orange : isLevel1 ? color.yellow : color.gray
    label.new(bar_index, volume,
              infoTxt,
              style=label.style_label_left,
              color=color.new(color.black, 20),
              textcolor=infoColor,
              size=size.normal)
