//@version=5
indicator("Pin Bar + OBV Divergence + Market Structure", shorttitle="PB+OBV+MS",
     overlay=true, max_labels_count=500, max_lines_count=500)

// =====================================================================
// 1. PIN BAR
// =====================================================================
grp_pin = "1. Pin Bar"
wickBodyRatio  = input.float(2.0, "Min wick-to-body ratio", minval=1.0, step=0.1, group=grp_pin)
maxOppWickPct  = input.float(30.0, "Max opposite wick (% of range)", minval=0.0, maxval=50.0, group=grp_pin)
bodyNearEndPct = input.float(30.0, "Body within X% of the long-wick end", minval=5.0, maxval=50.0, group=grp_pin)

// =====================================================================
// 2. OBV DIVERGENCE
// =====================================================================
grp_obv = "2. OBV Divergence"
requirePinDiv = input.bool(true, "Require a pin bar with the divergence",
     tooltip="On = only flag divergence landing on a pin bar (far fewer, higher quality).", group=grp_obv)
pivotLeft     = input.int(5, "Pivot lookback (left bars)", minval=1, group=grp_obv)
pivotRight    = input.int(5, "Pivot lookback (right bars)", minval=1, group=grp_obv)
maxPivotBars  = input.int(60, "Max bars between pivots", minval=5, group=grp_obv)
detectRegular = input.bool(true, "Detect regular divergence (reversal)", group=grp_obv)
detectHidden  = input.bool(true, "Detect hidden divergence (continuation)", group=grp_obv)

grp_ltf = "3. Lower-Timeframe Confirmation"
useLTF = input.bool(false, "Require lower-timeframe OBV divergence too", group=grp_ltf)
ltfRes = input.timeframe("15", "Lower timeframe", group=grp_ltf)

// =====================================================================
// 4. MARKET STRUCTURE
// =====================================================================
grp_ms = "4. Market Structure (BOS / CHoCH)"
swingLen      = input.int(10, "Swing pivot length (bars each side)", minval=1,
     tooltip="Main noise dial. On a 1-minute chart try 25-50. On 1H, 10-20 is reasonable.", group=grp_ms)
breakMode     = input.string("Close", "Break confirmation", options=["Close", "Wick"], group=grp_ms)
breakBufferAtr = input.float(0.0, "Min break distance (x ATR)", minval=0.0, step=0.05, group=grp_ms)
atrLen        = input.int(14, "ATR length", minval=1, group=grp_ms)
requireObvConf = input.bool(true, "Require OBV to confirm the structure break", group=grp_ms)

// =====================================================================
// 5. TRADES
// =====================================================================
grp_tr = "5. Trades (Entry / Stop / Target)"
enableTrades = input.bool(true, "Track trades", group=grp_tr)
entryOn      = input.string("CHoCH", "Enter on", options=["CHoCH", "CHoCH + BOS", "Divergence", "CHoCH + Divergence"],
     tooltip="Which signal opens a position. CHoCH = reversal breaks only.", group=grp_tr)
allowLongs   = input.bool(true, "Allow longs", group=grp_tr)
allowShorts  = input.bool(true, "Allow shorts", group=grp_tr)
stopMode     = input.string("Structure", "Stop placement", options=["Structure", "Recent swing", "ATR"],
     tooltip="Structure = beyond the protected level that defines the setup (invalidation). ATR = fixed distance.", group=grp_tr)
stopAtrMult  = input.float(1.5, "  ATR stop multiple", minval=0.1, step=0.1, group=grp_tr)
stopBufAtr   = input.float(0.1, "  Extra buffer beyond level (x ATR)", minval=0.0, step=0.05, group=grp_tr)
rrRatio      = input.float(2.0, "Target (R multiple)", minval=0.1, step=0.1, group=grp_tr)
useBreakeven = input.bool(false, "Move stop to breakeven at 1R", group=grp_tr)
exitOpposite = input.bool(true, "Exit early on an opposite signal", group=grp_tr)

// =====================================================================
// 6. DISPLAY
// =====================================================================
grp_disp = "6. Display"
showTable       = input.bool(true, "Show status panel", group=grp_disp)
tablePos        = input.string(position.top_right, "Panel position",
     options=[position.top_right, position.top_left, position.bottom_right, position.bottom_left], group=grp_disp)
showDivLabels   = input.bool(true, "Show divergence labels", group=grp_disp)
showStructLabels = input.bool(true, "Show structure labels", group=grp_disp)
labelCooldown   = input.int(20, "Min bars between labels of the same type", minval=0,
     tooltip="Stops labels stacking on top of each other on fast timeframes.", group=grp_disp)
labelLookback   = input.int(300, "Only label the last N bars (0 = all)", minval=0,
     tooltip="Old labels add nothing but clutter. 0 shows the full history.", group=grp_disp)
labelOffsetAtr  = input.float(0.5, "Label distance from candle (x ATR)", minval=0.0, step=0.1,
     tooltip="Labels are anchored to each bar's own high/low plus this offset, so they track price at any zoom.", group=grp_disp)
lblSize         = input.string("Small", "Label size", options=["Tiny", "Small", "Normal"], group=grp_disp)
shortText       = input.bool(false, "Use short labels", group=grp_disp)
showTradeLines  = input.bool(true, "Draw entry / stop / target lines", group=grp_disp)
showLevels      = input.bool(false, "Draw protected structure levels", group=grp_disp)

labelSize = lblSize == "Tiny" ? size.tiny : lblSize == "Normal" ? size.normal : size.small

// =====================================================================
// Shared series
// =====================================================================
obv = ta.cum(math.sign(ta.change(close)) * volume)
atr = ta.atr(atrLen)

calcDivergence(int pLeft, int pRight, int maxBars) =>
    obvLocal = ta.cum(math.sign(ta.change(close)) * volume)
    pvl = ta.pivotlow(low, pLeft, pRight)
    pvh = ta.pivothigh(high, pLeft, pRight)
    var float llPrice = na
    var int   llBar   = na
    var float llObv   = na
    var float lhPrice = na
    var int   lhBar   = na
    var float lhObv   = na
    regBull = false
    hidBull = false
    regBear = false
    hidBear = false
    if not na(pvl)
        pb = bar_index - pRight
        po = obvLocal[pRight]
        if not na(llPrice) and (pb - llBar) <= maxBars
            regBull := pvl < llPrice and po > llObv
            hidBull := pvl > llPrice and po < llObv
        llPrice := pvl
        llBar   := pb
        llObv   := po
    if not na(pvh)
        pb = bar_index - pRight
        po = obvLocal[pRight]
        if not na(lhPrice) and (pb - lhBar) <= maxBars
            regBear := pvh > lhPrice and po < lhObv
            hidBear := pvh < lhPrice and po > lhObv
        lhPrice := pvh
        lhBar   := pb
        lhObv   := po
    [regBull, regBear, hidBull, hidBear]

latch(bool cond, int holdBars) =>
    var int expires = na
    if cond
        expires := bar_index + holdBars
    not na(expires) and bar_index <= expires

// Rate-limit a signal so labels do not stack. Per call site.
cooldownOk(bool cond, int bars) =>
    var int lastBar = na
    ok = cond and (na(lastBar) or bar_index - lastBar >= bars)
    if ok
        lastBar := bar_index
    ok

// =====================================================================
// Pin bars
// =====================================================================
barRange  = high - low
body      = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low

bullPin = barRange > 0 and lowerWick >= body * wickBodyRatio and
     upperWick <= barRange * maxOppWickPct / 100 and
     (high - math.max(close, open)) <= barRange * bodyNearEndPct / 100

bearPin = barRange > 0 and upperWick >= body * wickBodyRatio and
     lowerWick <= barRange * maxOppWickPct / 100 and
     (math.min(close, open) - low) <= barRange * bodyNearEndPct / 100

// =====================================================================
// Divergence
// =====================================================================
[regBullHere, regBearHere, hidBullHere, hidBearHere] = calcDivergence(pivotLeft, pivotRight, maxPivotBars)

hold = pivotRight + 3
recentRegBull = latch(regBullHere, hold)
recentRegBear = latch(regBearHere, hold)
recentHidBull = latch(hidBullHere, hold)
recentHidBear = latch(hidBearHere, hold)

[ltfRegBullRaw, ltfRegBearRaw, ltfHidBullRaw, ltfHidBearRaw] = request.security(
     syminfo.tickerid, ltfRes, calcDivergence(pivotLeft, pivotRight, maxPivotBars), lookahead=barmerge.lookahead_off)

trigBull = requirePinDiv ? bullPin : (regBullHere or hidBullHere)
trigBear = requirePinDiv ? bearPin : (regBearHere or hidBearHere)

divBullReg = detectRegular and trigBull and recentRegBull and (not useLTF or ltfRegBullRaw)
divBullHid = detectHidden  and trigBull and recentHidBull and (not useLTF or ltfHidBullRaw)
divBearReg = detectRegular and trigBear and recentRegBear and (not useLTF or ltfRegBearRaw)
divBearHid = detectHidden  and trigBear and recentHidBear and (not useLTF or ltfHidBearRaw)

divBullHidOnly = divBullHid and not divBullReg
divBearHidOnly = divBearHid and not divBearReg
anyDivBull = divBullReg or divBullHidOnly
anyDivBear = divBearReg or divBearHidOnly

// =====================================================================
// Market structure - protected levels
// =====================================================================
msPH = ta.pivothigh(high, swingLen, swingLen)
msPL = ta.pivotlow(low, swingLen, swingLen)

var float recentPH  = na
var float recentPL  = na
var float protHigh  = na
var float protLow   = na
var float obvAtHigh = na
var float obvAtLow  = na
var int   trend     = 0

if not na(msPH)
    recentPH := msPH
    if trend >= 0 or na(protHigh)
        protHigh := msPH
        obvAtHigh := obv[swingLen]

if not na(msPL)
    recentPL := msPL
    if trend <= 0 or na(protLow)
        protLow := msPL
        obvAtLow := obv[swingLen]

breakUpSrc = breakMode == "Close" ? close : high
breakDnSrc = breakMode == "Close" ? close : low
buffer     = breakBufferAtr * atr

rawUp = not na(protHigh) and breakUpSrc > protHigh + buffer
rawDn = not na(protLow)  and breakDnSrc < protLow  - buffer
ambiguous = rawUp and rawDn
brokeUp   = rawUp and not ambiguous
brokeDn   = rawDn and not ambiguous

obvConfUp = not requireObvConf or (not na(obvAtHigh) and obv > obvAtHigh)
obvConfDn = not requireObvConf or (not na(obvAtLow)  and obv < obvAtLow)

bullBOS   = false
bullCHoCH = false
bearBOS   = false
bearCHoCH = false
var float brokenLevel = na
var int   trendBefore = 0
var float stopRefLong  = na   // structural low to hide a long stop behind
var float stopRefShort = na

if brokeUp
    trendBefore := trend
    brokenLevel := protHigh
    if trend == 1
        bullBOS := true
    else if trend == -1
        bullCHoCH := true
    trend := 1
    stopRefLong := recentPL
    protLow  := recentPL
    obvAtLow := obv
    protHigh := na

if brokeDn
    trendBefore := trend
    brokenLevel := protLow
    if trend == -1
        bearBOS := true
    else if trend == 1
        bearCHoCH := true
    trend := -1
    stopRefShort := recentPH
    protHigh  := recentPH
    obvAtHigh := obv
    protLow   := na

structBull = obvConfUp and (bullCHoCH or bullBOS)
structBear = obvConfDn and (bearCHoCH or bearBOS)

// =====================================================================
// Trades: entry, stop, target, exit
// =====================================================================
entryBull = switch entryOn
    "CHoCH"              => structBull and bullCHoCH
    "CHoCH + BOS"        => structBull
    "Divergence"         => anyDivBull
    "CHoCH + Divergence" => (structBull and bullCHoCH) or anyDivBull
    => false

entryBear = switch entryOn
    "CHoCH"              => structBear and bearCHoCH
    "CHoCH + BOS"        => structBear
    "Divergence"         => anyDivBear
    "CHoCH + Divergence" => (structBear and bearCHoCH) or anyDivBear
    => false

entryBull := entryBull and enableTrades and allowLongs
entryBear := entryBear and enableTrades and allowShorts

var int   tDir    = 0     // 0 flat, 1 long, -1 short
var float tEntry  = na
var float tStop   = na
var float tTgt    = na
var float tRisk   = na
var int   tOpenBar = na
var bool  beMoved = false

var int   wins    = 0
var int   losses  = 0
var int   scratch = 0
var float rTotal  = 0.0
var float lastR   = na

openedLong  = false
openedShort = false
closedWin   = false
closedLoss  = false
closedFlat  = false

// --- manage an open position first, so a bar can close one trade and open another
if tDir != 0
    if useBreakeven and not beMoved and tRisk > 0
        prog = tDir == 1 ? (high - tEntry) / tRisk : (tEntry - low) / tRisk
        if prog >= 1.0
            tStop := tEntry
            beMoved := true

    hitStop = tDir == 1 ? low <= tStop : high >= tStop
    hitTgt  = tDir == 1 ? high >= tTgt : low <= tTgt

    // If a single bar spans both levels the order inside the bar is unknowable,
    // so assume the stop filled first. Pessimistic on purpose.
    if hitStop
        r = tRisk > 0 ? (tStop - tEntry) / tRisk * tDir : 0.0
        rTotal += r
        lastR := r
        if r > 0
            wins += 1
            closedWin := true
        else if r < 0
            losses += 1
            closedLoss := true
        else
            scratch += 1
            closedFlat := true
        tDir := 0
    else if hitTgt
        r = tRisk > 0 ? (tTgt - tEntry) / tRisk * tDir : 0.0
        rTotal += r
        lastR := r
        wins += 1
        closedWin := true
        tDir := 0
    else if exitOpposite and ((tDir == 1 and entryBear) or (tDir == -1 and entryBull))
        r = tRisk > 0 ? (close - tEntry) / tRisk * tDir : 0.0
        rTotal += r
        lastR := r
        if r > 0
            wins += 1
            closedWin := true
        else if r < 0
            losses += 1
            closedLoss := true
        else
            scratch += 1
            closedFlat := true
        tDir := 0

// --- open a new position
if tDir == 0 and (entryBull or entryBear)
    dir = entryBull ? 1 : -1
    entry = close
    structStop = dir == 1 ? (na(stopRefLong) ? recentPL : stopRefLong) : (na(stopRefShort) ? recentPH : stopRefShort)
    swingStop  = dir == 1 ? recentPL : recentPH
    raw = switch stopMode
        "Structure"    => structStop
        "Recent swing" => swingStop
        => na
    // Fall back to an ATR stop when no structural level is available yet.
    stopPx = na(raw) ? (dir == 1 ? entry - stopAtrMult * atr : entry + stopAtrMult * atr) :
         (dir == 1 ? raw - stopBufAtr * atr : raw + stopBufAtr * atr)
    risk = math.abs(entry - stopPx)
    if risk > 0
        tDir    := dir
        tEntry  := entry
        tStop   := stopPx
        tRisk   := risk
        tTgt    := dir == 1 ? entry + risk * rrRatio : entry - risk * rrRatio
        tOpenBar := bar_index
        beMoved := false
        if dir == 1
            openedLong := true
        else
            openedShort := true

// =====================================================================
// Trade lines for the open position
// =====================================================================
var line lnEntry = na
var line lnStop  = na
var line lnTgt   = na

if showTradeLines
    if openedLong or openedShort
        lnEntry := line.new(bar_index, tEntry, bar_index + 1, tEntry, color=color.new(color.blue, 0), width=1)
        lnStop  := line.new(bar_index, tStop,  bar_index + 1, tStop,  color=color.new(color.red, 0), width=1, style=line.style_dashed)
        lnTgt   := line.new(bar_index, tTgt,   bar_index + 1, tTgt,   color=color.new(color.teal, 0), width=1, style=line.style_dashed)
    if tDir != 0 and not na(lnEntry)
        line.set_x2(lnEntry, bar_index + 1)
        line.set_x2(lnStop,  bar_index + 1)
        line.set_x2(lnTgt,   bar_index + 1)
        line.set_y2(lnStop,  tStop)   // follows a breakeven move
        line.set_y1(lnStop,  tStop)

plotshape(openedLong,  title="Long entry",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.blue, 0), size=size.tiny)
plotshape(openedShort, title="Short entry", style=shape.triangledown, location=location.abovebar, color=color.new(color.blue, 0), size=size.tiny)
plotshape(closedWin,   title="Target hit",  style=shape.xcross, location=location.abovebar, color=color.new(color.teal, 0), size=size.tiny)
plotshape(closedLoss,  title="Stop hit",    style=shape.xcross, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)
plotshape(closedFlat,  title="Scratch",     style=shape.xcross, location=location.abovebar, color=color.new(color.gray, 0), size=size.tiny)

// =====================================================================
// Labels
// =====================================================================
trendTxt(int t) => t == 1 ? "Bullish" : t == -1 ? "Bearish" : "Undetermined"

// Anchored with an explicit price derived from THIS bar's own high/low, so a label
// always sits next to its candle no matter how the chart is zoomed or resized.
inLabelWindow = labelLookback == 0 or (last_bar_index - bar_index) <= labelLookback

drawLabel(bool cond, string txt, bool isBull, color col, string tip) =>
    if cond and inLabelWindow
        yPx = isBull ? low - labelOffsetAtr * atr : high + labelOffsetAtr * atr
        label.new(bar_index, yPx, text=txt,
             xloc=xloc.bar_index, yloc=yloc.price,
             style = isBull ? label.style_label_up : label.style_label_down,
             color=col, textcolor=color.white, size=labelSize, tooltip=tip)

divTip(string kind) =>
    kind + "\nClose: " + str.tostring(close, format.mintick) +
     "\nOBV: " + str.tostring(obv, "#.##")

msTip(string kind) =>
    kind + "\nBroken level: " + str.tostring(brokenLevel, format.mintick) +
     "\nClose: " + str.tostring(close, format.mintick) +
     "\nTrend before: " + trendTxt(trendBefore) +
     "\nTrend after: " + trendTxt(trend) +
     "\nOBV: " + str.tostring(obv, "#.##")

txtBullDiv = shortText ? "Bull Div"    : "Bullish Divergence"
txtBearDiv = shortText ? "Bear Div"    : "Bearish Divergence"
txtBullHid = shortText ? "Bull Hidden" : "Bullish Hidden Div"
txtBearHid = shortText ? "Bear Hidden" : "Bearish Hidden Div"
txtBullCh  = shortText ? "Bull CHoCH"  : "Bullish CHoCH"
txtBearCh  = shortText ? "Bear CHoCH"  : "Bearish CHoCH"
txtBullBos = shortText ? "Bull BOS"    : "Bullish BOS"
txtBearBos = shortText ? "Bear BOS"    : "Bearish BOS"

lblDivBullReg = cooldownOk(showDivLabels and divBullReg, labelCooldown)
lblDivBearReg = cooldownOk(showDivLabels and divBearReg, labelCooldown)
lblDivBullHid = cooldownOk(showDivLabels and divBullHidOnly, labelCooldown)
lblDivBearHid = cooldownOk(showDivLabels and divBearHidOnly, labelCooldown)
lblBullCh = cooldownOk(showStructLabels and structBull and bullCHoCH, labelCooldown)
lblBearCh = cooldownOk(showStructLabels and structBear and bearCHoCH, labelCooldown)
lblBullBos = cooldownOk(showStructLabels and structBull and bullBOS, labelCooldown)
lblBearBos = cooldownOk(showStructLabels and structBear and bearBOS, labelCooldown)

drawLabel(lblDivBullReg, txtBullDiv, true,  color.new(color.lime, 15),   divTip("Bullish regular divergence"))
drawLabel(lblDivBearReg, txtBearDiv, false, color.new(color.red, 15),    divTip("Bearish regular divergence"))
drawLabel(lblDivBullHid, txtBullHid, true,  color.new(color.teal, 15),   divTip("Bullish hidden divergence"))
drawLabel(lblDivBearHid, txtBearHid, false, color.new(color.orange, 15), divTip("Bearish hidden divergence"))
drawLabel(lblBullCh,  txtBullCh,  true,  color.new(color.green, 0),   msTip("Bullish CHoCH - reversal"))
drawLabel(lblBearCh,  txtBearCh,  false, color.new(color.maroon, 0),  msTip("Bearish CHoCH - reversal"))
drawLabel(lblBullBos, txtBullBos, true,  color.new(color.green, 45),  msTip("Bullish BOS - continuation"))
drawLabel(lblBearBos, txtBearBos, false, color.new(color.maroon, 45), msTip("Bearish BOS - continuation"))

plot(showLevels ? protHigh : na, title="Protected high", color=color.new(color.red, 50), style=plot.style_linebr)
plot(showLevels ? protLow  : na, title="Protected low",  color=color.new(color.green, 50), style=plot.style_linebr)

// =====================================================================
// Alerts
// =====================================================================
alertcondition(divBullReg, title="Bullish Divergence", message="Bullish OBV divergence on {{ticker}} {{interval}}")
alertcondition(divBearReg, title="Bearish Divergence", message="Bearish OBV divergence on {{ticker}} {{interval}}")
alertcondition(structBull and bullCHoCH, title="Bullish CHoCH", message="Bullish CHoCH on {{ticker}} {{interval}} - close {{close}}")
alertcondition(structBear and bearCHoCH, title="Bearish CHoCH", message="Bearish CHoCH on {{ticker}} {{interval}} - close {{close}}")
alertcondition(structBull and bullBOS,   title="Bullish BOS",   message="Bullish BOS on {{ticker}} {{interval}} - close {{close}}")
alertcondition(structBear and bearBOS,   title="Bearish BOS",   message="Bearish BOS on {{ticker}} {{interval}} - close {{close}}")
alertcondition(openedLong,  title="Trade: Long entry",  message="LONG entry on {{ticker}} {{interval}} at {{close}}")
alertcondition(openedShort, title="Trade: Short entry", message="SHORT entry on {{ticker}} {{interval}} at {{close}}")
alertcondition(closedWin,   title="Trade: Target hit",  message="Target hit on {{ticker}} {{interval}}")
alertcondition(closedLoss,  title="Trade: Stop hit",    message="Stop hit on {{ticker}} {{interval}}")

// =====================================================================
// Status panel
// =====================================================================
var table t = table.new(tablePos, 2, 16, border_width=1)

var string lastDiv = "None"
var int lastDivTime = na
var string lastMS = "None"
var int lastMSTime = na

if anyDivBull
    lastDiv := divBullReg ? "Bullish Divergence" : "Bullish Hidden"
    lastDivTime := time
if anyDivBear
    lastDiv := divBearReg ? "Bearish Divergence" : "Bearish Hidden"
    lastDivTime := time
if structBull or structBear
    lastMS := (structBull ? "Bullish " : "Bearish ") + ((bullCHoCH or bearCHoCH) ? "CHoCH" : "BOS") +
         " @ " + str.tostring(brokenLevel, format.mintick)
    lastMSTime := time

fmtTime(int tm) => na(tm) ? "-" : str.format_time(tm, "yyyy-MM-dd HH:mm", syminfo.timezone)
px(float p) => na(p) ? "-" : str.tostring(p, format.mintick)

closedTrades = wins + losses + scratch
winRate = closedTrades > 0 ? wins / closedTrades * 100 : na
openR = tDir != 0 and tRisk > 0 ? (close - tEntry) / tRisk * tDir : na

statusTxt = tDir == 1 ? "LONG open" : tDir == -1 ? "SHORT open" : "Flat"
statusCol = tDir == 1 ? color.lime : tDir == -1 ? color.red : color.silver

if showTable and barstate.islast
    table.cell(t, 0, 0, "TRADE", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(t, 1, 0, "", bgcolor=color.new(color.blue, 40))
    table.cell(t, 0, 1, "Status", text_color=color.silver)
    table.cell(t, 1, 1, statusTxt, text_color=statusCol)
    table.cell(t, 0, 2, "Entry", text_color=color.silver)
    table.cell(t, 1, 2, tDir == 0 ? "-" : px(tEntry), text_color=color.white)
    table.cell(t, 0, 3, "Stop loss", text_color=color.silver)
    table.cell(t, 1, 3, tDir == 0 ? "-" : px(tStop) + (beMoved ? " (BE)" : ""), text_color=color.red)
    table.cell(t, 0, 4, "Target", text_color=color.silver)
    table.cell(t, 1, 4, tDir == 0 ? "-" : px(tTgt), text_color=color.teal)
    table.cell(t, 0, 5, "Risk (points)", text_color=color.silver)
    table.cell(t, 1, 5, tDir == 0 ? "-" : str.tostring(tRisk, format.mintick), text_color=color.white)
    table.cell(t, 0, 6, "Open P/L (R)", text_color=color.silver)
    table.cell(t, 1, 6, na(openR) ? "-" : str.tostring(openR, "#.##") + "R",
         text_color=na(openR) ? color.silver : openR >= 0 ? color.lime : color.red)

    table.cell(t, 0, 7, "PERFORMANCE", text_color=color.white, bgcolor=color.new(color.blue, 40))
    table.cell(t, 1, 7, "", bgcolor=color.new(color.blue, 40))
    table.cell(t, 0, 8, "Closed trades", text_color=color.silver)
    table.cell(t, 1, 8, str.tostring(closedTrades), text_color=color.white)
    table.cell(t, 0, 9, "Win / Loss / BE", text_color=color.silver)
    table.cell(t, 1, 9, str.tostring(wins) + " / " + str.tostring(losses) + " / " + str.tostring(scratch), text_color=color.white)
    table.cell(t, 0, 10, "Win rate", text_color=color.silver)
    table.cell(t, 1, 10, na(winRate) ? "-" : str.tostring(winRate, "#.#") + "%", text_color=color.white)
    table.cell(t, 0, 11, "Total R", text_color=color.silver)
    table.cell(t, 1, 11, str.tostring(rTotal, "#.##") + "R", text_color=rTotal >= 0 ? color.lime : color.red)

    table.cell(t, 0, 12, "STRUCTURE", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(t, 1, 12, "", bgcolor=color.new(color.gray, 20))
    table.cell(t, 0, 13, "Current trend", text_color=color.silver)
    table.cell(t, 1, 13, trendTxt(trend), text_color=trend == 1 ? color.lime : trend == -1 ? color.red : color.silver)
    table.cell(t, 0, 14, "Last event", text_color=color.silver)
    table.cell(t, 1, 14, lastMS, text_color=color.white)
    table.cell(t, 0, 15, "Last divergence", text_color=color.silver)
    table.cell(t, 1, 15, lastDiv + "  " + fmtTime(lastDivTime), text_color=color.white)
