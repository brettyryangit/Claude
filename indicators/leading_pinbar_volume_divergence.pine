//@version=5
indicator("Leading Pin Bar + OBV Divergence Confluence", shorttitle="PinBar+OBV Lead", overlay=true, max_labels_count=500)

// ---------- Inputs ----------
grp_pin = "Pin Bar"
wickBodyRatio   = input.float(2.0, "Min wick-to-body ratio", minval=1.0, step=0.1, group=grp_pin)
maxOppWickPct   = input.float(30.0, "Max opposite wick (% of range)", minval=0.0, maxval=50.0, group=grp_pin)
bodyNearEndPct  = input.float(30.0, "Body must sit within X% of the long-wick end", minval=5.0, maxval=50.0, group=grp_pin)

grp_obv = "OBV Divergence"
pivotLeft    = input.int(5, "Pivot lookback (left bars)", minval=1, group=grp_obv)
pivotRight   = input.int(5, "Pivot lookback (right bars)", minval=1, group=grp_obv)
maxPivotBars = input.int(60, "Max bars between pivots", minval=5, group=grp_obv)

grp_ltf = "Lower-Timeframe Confirmation"
useLTF = input.bool(true, "Require lower-timeframe OBV divergence too", group=grp_ltf)
ltfRes = input.timeframe("15", "Lower timeframe", group=grp_ltf)

// ---------- Reusable divergence calc (used locally and via request.security) ----------
calcDivergence(int pLeft, int pRight, int maxBars) =>
    obvLocal = ta.cum(math.sign(ta.change(close)) * volume)
    pl = ta.pivotlow(low, pLeft, pRight)
    ph = ta.pivothigh(high, pLeft, pRight)
    var float llPrice = na
    var int   llBar   = na
    var float llObv   = na
    var float lhPrice = na
    var int   lhBar   = na
    var float lhObv   = na
    bDiv = false
    sDiv = false
    if not na(pl)
        pb = bar_index - pRight
        po = obvLocal[pRight]
        if not na(llPrice) and (pb - llBar) <= maxBars
            bDiv := pl < llPrice and po > llObv
        llPrice := pl
        llBar   := pb
        llObv   := po
    if not na(ph)
        pb = bar_index - pRight
        po = obvLocal[pRight]
        if not na(lhPrice) and (pb - lhBar) <= maxBars
            sDiv := ph > lhPrice and po < lhObv
        lhPrice := ph
        lhBar   := pb
        lhObv   := po
    [bDiv, sDiv]

// ---------- Pin bar detection (current timeframe) ----------
barRange  = high - low
body      = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low

bullPin = barRange > 0 and lowerWick >= body * wickBodyRatio and
     upperWick <= barRange * maxOppWickPct / 100 and
     (high - math.max(close, open)) <= barRange * bodyNearEndPct / 100

bearPin = barRange > 0 and upperWick >= body * wickBodyRatio and
     lowerWick <= barRange * maxOppWickPct / 100 and
     (math.min(close, open) - low) <= barRange * bodyNearEndPct / 100

// ---------- Current-timeframe OBV divergence ----------
[bullDivHere, bearDivHere] = calcDivergence(pivotLeft, pivotRight, maxPivotBars)

// bullDivHere/bearDivHere fire on the pivot bar (pivotRight bars in the past); latch it
// forward a few bars so it can still line up with a pin bar that prints slightly later.
var int bullDivExpiresBar = na
var int bearDivExpiresBar = na
if bullDivHere
    bullDivExpiresBar := bar_index + pivotRight + 3
if bearDivHere
    bearDivExpiresBar := bar_index + pivotRight + 3
recentBullDiv = not na(bullDivExpiresBar) and bar_index <= bullDivExpiresBar
recentBearDiv = not na(bearDivExpiresBar) and bar_index <= bearDivExpiresBar

// ---------- Lower-timeframe OBV divergence confirmation ----------
ltfBullDiv = false
ltfBearDiv = false
if useLTF
    [b, s] = request.security(syminfo.tickerid, ltfRes, calcDivergence(pivotLeft, pivotRight, maxPivotBars), lookahead=barmerge.lookahead_off)
    ltfBullDiv := b
    ltfBearDiv := s

// ---------- Confluence signals ----------
longSignal  = bullPin and recentBullDiv and (not useLTF or ltfBullDiv)
shortSignal = bearPin and recentBearDiv and (not useLTF or ltfBearDiv)

plotshape(longSignal, title="Bullish Confluence", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.lime, 0), size=size.small, text="PIN+OBV")
plotshape(shortSignal, title="Bearish Confluence", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.small, text="PIN+OBV")

plotshape(bullPin and not longSignal, title="Pin Bar Only (Bull)", style=shape.circle, location=location.belowbar,
     color=color.new(color.lime, 70), size=size.tiny)
plotshape(bearPin and not shortSignal, title="Pin Bar Only (Bear)", style=shape.circle, location=location.abovebar,
     color=color.new(color.red, 70), size=size.tiny)

alertcondition(longSignal, title="Bullish Pin Bar + OBV Divergence", message="Bullish pin bar with OBV divergence confluence on {{ticker}} {{interval}}")
alertcondition(shortSignal, title="Bearish Pin Bar + OBV Divergence", message="Bearish pin bar with OBV divergence confluence on {{ticker}} {{interval}}")
