//@version=5
indicator("Pin Bar + OBV Divergence + Market Structure", shorttitle="PB+OBV+MS",
     overlay=true, max_labels_count=500)

// =====================================================================
// 1. PIN BAR
// =====================================================================
grp_pin = "1. Pin Bar"
wickBodyRatio  = input.float(2.0, "Min wick-to-body ratio", minval=1.0, step=0.1, group=grp_pin)
maxOppWickPct  = input.float(30.0, "Max opposite wick (% of range)", minval=0.0, maxval=50.0, group=grp_pin)
bodyNearEndPct = input.float(30.0, "Body within X% of the long-wick end", minval=5.0, maxval=50.0, group=grp_pin)

// =====================================================================
// 2. OBV DIVERGENCE
// =====================================================================
grp_obv = "2. OBV Divergence"
showDiv       = input.bool(true, "Show divergence signals", group=grp_obv)
requirePinDiv = input.bool(true, "Require a pin bar with the divergence",
     tooltip="On = only flag divergence that lands on a pin bar (far fewer, higher quality). Off = flag every divergence.", group=grp_obv)
pivotLeft     = input.int(5, "Pivot lookback (left bars)", minval=1, group=grp_obv)
pivotRight    = input.int(5, "Pivot lookback (right bars)", minval=1, group=grp_obv)
maxPivotBars  = input.int(60, "Max bars between pivots", minval=5, group=grp_obv)
detectRegular = input.bool(true, "Detect regular divergence (reversal)", group=grp_obv)
detectHidden  = input.bool(true, "Detect hidden divergence (continuation)", group=grp_obv)

grp_ltf = "3. Lower-Timeframe Confirmation"
useLTF = input.bool(false, "Require lower-timeframe OBV divergence too", group=grp_ltf)
ltfRes = input.timeframe("15", "Lower timeframe", group=grp_ltf)

// =====================================================================
// 4. MARKET STRUCTURE
// =====================================================================
grp_ms = "4. Market Structure (BOS / CHoCH)"
showStructure = input.bool(true, "Show structure signals", group=grp_ms)
swingLen      = input.int(10, "Swing pivot length (bars each side)", minval=1,
     tooltip="Bars required either side of a high/low to confirm a swing. Bigger = fewer, more significant levels.", group=grp_ms)
breakMode     = input.string("Close", "Break confirmation", options=["Close", "Wick"],
     tooltip="Close = the bar must CLOSE beyond the level (stricter). Wick = any touch counts.", group=grp_ms)
breakBufferAtr = input.float(0.0, "Min break distance (x ATR)", minval=0.0, step=0.05,
     tooltip="Price must exceed the level by this multiple of ATR before the break counts.", group=grp_ms)
atrLen        = input.int(14, "ATR length", minval=1, group=grp_ms)
showCHoCH     = input.bool(true, "Show CHoCH (change of character / reversal)", group=grp_ms)
showBOS       = input.bool(true, "Show BOS (break of structure / continuation)", group=grp_ms)
requireObvConf = input.bool(true, "Require OBV to confirm the structure break",
     tooltip="OBV must break the OBV value recorded at that same swing point, not just price.", group=grp_ms)

// =====================================================================
// 5. DISPLAY
// =====================================================================
grp_disp = "5. Display"
showTable   = input.bool(true, "Show status table", group=grp_disp)
tablePos    = input.string(position.top_right, "Table position",
     options=[position.top_right, position.top_left, position.bottom_right, position.bottom_left], group=grp_disp)
lblSize     = input.string("Small", "Label size", options=["Tiny", "Small", "Normal"], group=grp_disp)
shortText   = input.bool(false, "Use short labels",
     tooltip="On = 'Bull CHoCH'. Off = 'Bullish CHoCH'.", group=grp_disp)
showPinDots = input.bool(false, "Mark unconfirmed pin bars (dots)", group=grp_disp)
showLevels  = input.bool(false, "Draw active structure levels", group=grp_disp)

labelSize = lblSize == "Tiny" ? size.tiny : lblSize == "Normal" ? size.normal : size.small

// =====================================================================
// Shared series
// =====================================================================
obv = ta.cum(math.sign(ta.change(close)) * volume)
atr = ta.atr(atrLen)

// =====================================================================
// Divergence calc: [regBull, regBear, hidBull, hidBear]
// =====================================================================
calcDivergence(int pLeft, int pRight, int maxBars) =>
    obvLocal = ta.cum(math.sign(ta.change(close)) * volume)
    pvl = ta.pivotlow(low, pLeft, pRight)
    pvh = ta.pivothigh(high, pLeft, pRight)
    var float llPrice = na
    var int   llBar   = na
    var float llObv   = na
    var float lhPrice = na
    var int   lhBar   = na
    var float lhObv   = na
    regBull = false
    hidBull = false
    regBear = false
    hidBear = false
    if not na(pvl)
        pb = bar_index - pRight
        po = obvLocal[pRight]
        if not na(llPrice) and (pb - llBar) <= maxBars
            regBull := pvl < llPrice and po > llObv  // lower low price, higher low OBV
            hidBull := pvl > llPrice and po < llObv  // higher low price, lower low OBV
        llPrice := pvl
        llBar   := pb
        llObv   := po
    if not na(pvh)
        pb = bar_index - pRight
        po = obvLocal[pRight]
        if not na(lhPrice) and (pb - lhBar) <= maxBars
            regBear := pvh > lhPrice and po < lhObv  // higher high price, lower high OBV
            hidBear := pvh < lhPrice and po > lhObv  // lower high price, higher high OBV
        lhPrice := pvh
        lhBar   := pb
        lhObv   := po
    [regBull, regBear, hidBull, hidBear]

// Hold a one-bar condition forward so it can line up with a later trigger.
latch(bool cond, int holdBars) =>
    var int expires = na
    if cond
        expires := bar_index + holdBars
    not na(expires) and bar_index <= expires

// =====================================================================
// Pin bars
// =====================================================================
barRange  = high - low
body      = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low

bullPin = barRange > 0 and lowerWick >= body * wickBodyRatio and
     upperWick <= barRange * maxOppWickPct / 100 and
     (high - math.max(close, open)) <= barRange * bodyNearEndPct / 100

bearPin = barRange > 0 and upperWick >= body * wickBodyRatio and
     lowerWick <= barRange * maxOppWickPct / 100 and
     (math.min(close, open) - low) <= barRange * bodyNearEndPct / 100

// =====================================================================
// Divergence signals
// =====================================================================
[regBullHere, regBearHere, hidBullHere, hidBearHere] = calcDivergence(pivotLeft, pivotRight, maxPivotBars)

hold = pivotRight + 3
recentRegBull = latch(regBullHere, hold)
recentRegBear = latch(regBearHere, hold)
recentHidBull = latch(hidBullHere, hold)
recentHidBear = latch(hidBearHere, hold)

// request.security() must sit at the top level - Pine rejects it inside an `if`.
[ltfRegBullRaw, ltfRegBearRaw, ltfHidBullRaw, ltfHidBearRaw] = request.security(
     syminfo.tickerid, ltfRes, calcDivergence(pivotLeft, pivotRight, maxPivotBars), lookahead=barmerge.lookahead_off)

ltfOkBullReg = not useLTF or ltfRegBullRaw
ltfOkBearReg = not useLTF or ltfRegBearRaw
ltfOkBullHid = not useLTF or ltfHidBullRaw
ltfOkBearHid = not useLTF or ltfHidBearRaw

pinOkBull = not requirePinDiv or bullPin
pinOkBear = not requirePinDiv or bearPin

// Fire on the bar the divergence is confirmed (or on the pin bar, if that is required).
trigBull = requirePinDiv ? bullPin : (regBullHere or hidBullHere)
trigBear = requirePinDiv ? bearPin : (regBearHere or hidBearHere)

divBullReg = showDiv and detectRegular and trigBull and pinOkBull and recentRegBull and ltfOkBullReg
divBullHid = showDiv and detectHidden  and trigBull and pinOkBull and recentHidBull and ltfOkBullHid
divBearReg = showDiv and detectRegular and trigBear and pinOkBear and recentRegBear and ltfOkBearReg
divBearHid = showDiv and detectHidden  and trigBear and pinOkBear and recentHidBear and ltfOkBearHid

// A bar can satisfy regular and hidden at once; regular wins so we draw one label.
divBullHidOnly = divBullHid and not divBullReg
divBearHidOnly = divBearHid and not divBearReg

anyDivBull = divBullReg or divBullHidOnly
anyDivBear = divBearReg or divBearHidOnly

// =====================================================================
// Market structure - protected levels, BOS and CHoCH
// =====================================================================
// The reference levels do NOT follow every minor pivot. After a bullish break the
// structural low is locked in; only a break of THAT level is a real change of
// character. Without this, every small pullback reads as a structure flip.
msPH = ta.pivothigh(high, swingLen, swingLen)
msPL = ta.pivotlow(low, swingLen, swingLen)

var float recentPH = na   // newest confirmed pivot high
var float recentPL = na   // newest confirmed pivot low
var float protHigh = na   // break above this = bullish structure event
var float protLow  = na   // break below this = bearish structure event
var float obvAtHigh = na
var float obvAtLow  = na
var int   trend     = 0   // 1 bullish, -1 bearish, 0 undetermined

if not na(msPH)
    recentPH := msPH
    // In an uptrend (or before structure is known) the newest swing high is the BOS
    // target. In a downtrend protHigh stays locked at the CHoCH level.
    if trend >= 0 or na(protHigh)
        protHigh := msPH
        obvAtHigh := obv[swingLen]

if not na(msPL)
    recentPL := msPL
    if trend <= 0 or na(protLow)
        protLow := msPL
        obvAtLow := obv[swingLen]

breakUpSrc = breakMode == "Close" ? close : high
breakDnSrc = breakMode == "Close" ? close : low
buffer     = breakBufferAtr * atr

rawUp = not na(protHigh) and breakUpSrc > protHigh + buffer
rawDn = not na(protLow)  and breakDnSrc < protLow  - buffer

// A bar that takes out both sides is ambiguous - signal neither.
ambiguous = rawUp and rawDn
brokeUp   = rawUp and not ambiguous
brokeDn   = rawDn and not ambiguous

obvConfUp = not requireObvConf or (not na(obvAtHigh) and obv > obvAtHigh)
obvConfDn = not requireObvConf or (not na(obvAtLow)  and obv < obvAtLow)

bullBOS   = false
bullCHoCH = false
bearBOS   = false
bearCHoCH = false
var float brokenLevel = na
var int   trendBefore = 0

if brokeUp
    trendBefore := trend
    brokenLevel := protHigh
    if trend == 1
        bullBOS := true
    else if trend == -1
        bullCHoCH := true
    trend := 1
    protLow  := recentPL    // lock the low that supported this move
    obvAtLow := obv
    protHigh := na          // next confirmed pivot high becomes the new target

if brokeDn
    trendBefore := trend
    brokenLevel := protLow
    if trend == -1
        bearBOS := true
    else if trend == 1
        bearCHoCH := true
    trend := -1
    protHigh  := recentPH
    obvAtHigh := obv
    protLow   := na

structBull = showStructure and obvConfUp and ((bullCHoCH and showCHoCH) or (bullBOS and showBOS))
structBear = showStructure and obvConfDn and ((bearCHoCH and showCHoCH) or (bearBOS and showBOS))

// =====================================================================
// Labels
// =====================================================================
trendTxt(int t) => t == 1 ? "Bullish" : t == -1 ? "Bearish" : "Undetermined"

drawLabel(bool cond, string txt, bool isBull, color col, string tip) =>
    if cond
        label.new(bar_index, isBull ? low : high, text=txt,
             yloc = isBull ? yloc.belowbar : yloc.abovebar,
             style = isBull ? label.style_label_up : label.style_label_down,
             color=col, textcolor=color.white, size=labelSize, tooltip=tip)

divTip(string kind) =>
    kind + "\nClose: " + str.tostring(close, format.mintick) +
     "\nOBV: " + str.tostring(obv, "#.##") +
     "\nPin bar required: " + (requirePinDiv ? "yes" : "no") +
     "\nLTF confirm: " + (useLTF ? ltfRes : "off")

msTip(string kind) =>
    kind + "\nBroken level: " + str.tostring(brokenLevel, format.mintick) +
     "\nClose: " + str.tostring(close, format.mintick) +
     "\nTrend before: " + trendTxt(trendBefore) +
     "\nTrend after: " + trendTxt(trend) +
     "\nOBV: " + str.tostring(obv, "#.##") +
     "\nATR(" + str.tostring(atrLen) + "): " + str.tostring(atr, format.mintick)

txtBullDiv = shortText ? "Bull Div"       : "Bullish Divergence"
txtBearDiv = shortText ? "Bear Div"       : "Bearish Divergence"
txtBullHid = shortText ? "Bull Hidden"    : "Bullish Hidden Div"
txtBearHid = shortText ? "Bear Hidden"    : "Bearish Hidden Div"
txtBullCh  = shortText ? "Bull CHoCH"     : "Bullish CHoCH"
txtBearCh  = shortText ? "Bear CHoCH"     : "Bearish CHoCH"
txtBullBos = shortText ? "Bull BOS"       : "Bullish BOS"
txtBearBos = shortText ? "Bear BOS"       : "Bearish BOS"

drawLabel(divBullReg,     txtBullDiv, true,  color.new(color.lime, 15),   divTip("Bullish regular divergence (reversal)"))
drawLabel(divBearReg,     txtBearDiv, false, color.new(color.red, 15),    divTip("Bearish regular divergence (reversal)"))
drawLabel(divBullHidOnly, txtBullHid, true,  color.new(color.teal, 15),   divTip("Bullish hidden divergence (continuation)"))
drawLabel(divBearHidOnly, txtBearHid, false, color.new(color.orange, 15), divTip("Bearish hidden divergence (continuation)"))

drawLabel(structBull and bullCHoCH, txtBullCh,  true,  color.new(color.green, 0),  msTip("Bullish CHoCH - reversal"))
drawLabel(structBear and bearCHoCH, txtBearCh,  false, color.new(color.maroon, 0), msTip("Bearish CHoCH - reversal"))
drawLabel(structBull and bullBOS,   txtBullBos, true,  color.new(color.green, 45), msTip("Bullish BOS - continuation"))
drawLabel(structBear and bearBOS,   txtBearBos, false, color.new(color.maroon, 45), msTip("Bearish BOS - continuation"))

plotshape(showPinDots and bullPin and not anyDivBull, title="Pin bar (bull, unconfirmed)",
     style=shape.circle, location=location.belowbar, color=color.new(color.lime, 75), size=size.tiny)
plotshape(showPinDots and bearPin and not anyDivBear, title="Pin bar (bear, unconfirmed)",
     style=shape.circle, location=location.abovebar, color=color.new(color.red, 75), size=size.tiny)

plot(showLevels ? protHigh : na, title="Protected high", color=color.new(color.red, 50),
     style=plot.style_linebr, linewidth=1, display=display.pane)
plot(showLevels ? protLow : na, title="Protected low", color=color.new(color.green, 50),
     style=plot.style_linebr, linewidth=1, display=display.pane)

// =====================================================================
// Alerts
// =====================================================================
alertcondition(divBullReg,     title="Bullish Divergence",     message="Bullish OBV divergence on {{ticker}} {{interval}}")
alertcondition(divBearReg,     title="Bearish Divergence",     message="Bearish OBV divergence on {{ticker}} {{interval}}")
alertcondition(divBullHidOnly, title="Bullish Hidden Divergence", message="Bullish hidden OBV divergence on {{ticker}} {{interval}}")
alertcondition(divBearHidOnly, title="Bearish Hidden Divergence", message="Bearish hidden OBV divergence on {{ticker}} {{interval}}")
alertcondition(structBull and bullCHoCH, title="Bullish CHoCH", message="Bullish CHoCH on {{ticker}} {{interval}} - close {{close}}")
alertcondition(structBear and bearCHoCH, title="Bearish CHoCH", message="Bearish CHoCH on {{ticker}} {{interval}} - close {{close}}")
alertcondition(structBull and bullBOS,   title="Bullish BOS",   message="Bullish BOS on {{ticker}} {{interval}} - close {{close}}")
alertcondition(structBear and bearBOS,   title="Bearish BOS",   message="Bearish BOS on {{ticker}} {{interval}} - close {{close}}")

// =====================================================================
// Status table
// =====================================================================
var table t = table.new(tablePos, 2, 11, border_width=1)
var int cDivBull = 0
var int cDivBear = 0
var int cChoch   = 0
var int cBos     = 0
var string lastDiv = "None"
var int lastDivTime = na
var string lastMS = "None"
var int lastMSTime = na

if anyDivBull
    cDivBull += 1
    lastDiv := divBullReg ? "Bullish Divergence" : "Bullish Hidden"
    lastDivTime := time
if anyDivBear
    cDivBear += 1
    lastDiv := divBearReg ? "Bearish Divergence" : "Bearish Hidden"
    lastDivTime := time

if structBull or structBear
    isChoch = bullCHoCH or bearCHoCH
    if isChoch
        cChoch += 1
    else
        cBos += 1
    lastMS := (structBull ? "Bullish " : "Bearish ") + (isChoch ? "CHoCH" : "BOS") +
         " @ " + str.tostring(brokenLevel, format.mintick)
    lastMSTime := time

fmtTime(int tm) => na(tm) ? "-" : str.format_time(tm, "yyyy-MM-dd HH:mm", syminfo.timezone)

if showTable and barstate.islast
    table.cell(t, 0, 0, "DIVERGENCE", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(t, 1, 0, "", bgcolor=color.new(color.gray, 20))
    table.cell(t, 0, 1, "Last", text_color=color.silver)
    table.cell(t, 1, 1, lastDiv, text_color=color.white)
    table.cell(t, 0, 2, "Time", text_color=color.silver)
    table.cell(t, 1, 2, fmtTime(lastDivTime), text_color=color.white)
    table.cell(t, 0, 3, "Bullish / Bearish", text_color=color.silver)
    table.cell(t, 1, 3, str.tostring(cDivBull) + " / " + str.tostring(cDivBear), text_color=color.white)

    table.cell(t, 0, 4, "MARKET STRUCTURE", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(t, 1, 4, "", bgcolor=color.new(color.gray, 20))
    table.cell(t, 0, 5, "Current trend", text_color=color.silver)
    table.cell(t, 1, 5, trendTxt(trend), text_color=trend == 1 ? color.lime : trend == -1 ? color.red : color.silver)
    table.cell(t, 0, 6, "Protected high", text_color=color.silver)
    table.cell(t, 1, 6, na(protHigh) ? "waiting for pivot" : str.tostring(protHigh, format.mintick), text_color=color.white)
    table.cell(t, 0, 7, "Protected low", text_color=color.silver)
    table.cell(t, 1, 7, na(protLow) ? "waiting for pivot" : str.tostring(protLow, format.mintick), text_color=color.white)
    table.cell(t, 0, 8, "Last event", text_color=color.silver)
    table.cell(t, 1, 8, lastMS, text_color=color.white)
    table.cell(t, 0, 9, "Time", text_color=color.silver)
    table.cell(t, 1, 9, fmtTime(lastMSTime), text_color=color.white)
    table.cell(t, 0, 10, "CHoCH / BOS", text_color=color.silver)
    table.cell(t, 1, 10, str.tostring(cChoch) + " / " + str.tostring(cBos), text_color=color.white)
