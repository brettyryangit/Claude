//@version=6
indicator("Candle Reversal — Fixed R:R Trade Detector", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ---- Inputs ----------------------------------------------------------------
maxRiskTicksInput = input.int(124, title = "Max Risk (ticks) — skip trade if exceeded", minval = 1)
rewardRatioInput  = input.float(1.0, title = "Reward:Risk Ratio (1.0 = 1:1, 2.0 = 1:2, etc.)", minval = 0.1, step = 0.1)
stopLookback      = input.int(1, title = "Stop Reference Candle (0=signal candle, 1=one before, 2=two before)", options = [0, 1, 2])
takeShorts        = input.bool(true, title = "Take bullish→bearish (short) signals")
takeLongs         = input.bool(true, title = "Take bearish→bullish (long) signals")
showWinLabels     = input.bool(true, title = "Show winning trade labels")
showLossLabels    = input.bool(true, title = "Show losing trade labels")
showSkippedLabels = input.bool(true, title = "Show skipped-signal labels")
showStatsTable    = input.bool(true, title = "Show stats table")

useLookbackStart  = input.bool(false, title = "Limit calculation start date")
lookbackStart     = input.time(timestamp("2024-01-01 00:00"), title = "Calculate from")

enableOptimizer   = input.bool(true, title = "Optimizer: enabled", group = "Parameter Optimizer")
sweepRrMin        = input.float(0.5, title = "Optimizer: R:R min", minval = 0.1, step = 0.1, group = "Parameter Optimizer")
sweepRrMax        = input.float(3.0, title = "Optimizer: R:R max", minval = 0.1, step = 0.1, group = "Parameter Optimizer")
sweepRrStep       = input.float(0.5, title = "Optimizer: R:R step", minval = 0.1, step = 0.1, group = "Parameter Optimizer")
sweepRiskMin      = input.int(40, title = "Optimizer: Max Risk min (ticks)", minval = 1, group = "Parameter Optimizer")
sweepRiskMax      = input.int(200, title = "Optimizer: Max Risk max (ticks)", minval = 1, group = "Parameter Optimizer")
sweepRiskStep     = input.int(20, title = "Optimizer: Max Risk step (ticks)", minval = 1, group = "Parameter Optimizer")
minTradesInput    = input.int(5, title = "Optimizer: min trades to qualify", minval = 1, group = "Parameter Optimizer")

tickSize = syminfo.mintick

// ---- Live trade state -------------------------------------------------------
// Every qualifying flip opens its own trade, independent of any others still
// running — these are growing lists of concurrently open trades, not a single slot.
var array<bool>  liveActive    = array.new<bool>(0)
var array<bool>  liveIsLong    = array.new<bool>(0)
var array<float> liveStop      = array.new<float>(0)
var array<float> liveTarget    = array.new<float>(0)
var array<int>   liveEntryBar  = array.new<int>(0)
var array<int>   liveRiskTicks = array.new<int>(0)
var array<box>   liveRiskBox   = array.new<box>(0)
var array<box>   liveRewardBox = array.new<box>(0)
var array<line>  liveEntryLine = array.new<line>(0)

var int   totalWins         = 0
var int   totalLosses       = 0
var int   netTicks          = 0
var float grossProfitTicks  = 0.0
var float grossLossTicks    = 0.0
var int   currentLossStreak = 0
var int   maxLossStreak     = 0
var int   startTime         = na

if barstate.isfirst
    startTime := time

// ---- Parameter optimizer state ----------------------------------------------
// Sweeps every (R:R, Max Risk) combination across the chart's history using the
// same signal/reference-candle rules as the live setup, tracking each combo's
// own win/loss record independently so the best-performing pair can be surfaced.
// Unlike the live setup above, each combo here runs one trade at a time — testing
// every combo's own unlimited-concurrency version would be far more expensive to
// compute, and one-at-a-time is enough to rank combos against each other.
var array<float> comboRR          = array.new<float>(0)
var array<int>   comboRiskCap     = array.new<int>(0)
var array<bool>  comboActive      = array.new<bool>(0)
var array<bool>  comboIsLong      = array.new<bool>(0)
var array<float> comboStop        = array.new<float>(0)
var array<float> comboTarget      = array.new<float>(0)
var array<int>   comboEntryBar    = array.new<int>(0)
var array<int>   comboRiskTicks   = array.new<int>(0)
var array<int>   comboWins        = array.new<int>(0)
var array<int>   comboLosses      = array.new<int>(0)
var array<float> comboGrossProfit = array.new<float>(0)
var array<float> comboGrossLoss   = array.new<float>(0)
var int          comboCount       = 0
var bool         sweepInit        = false

if enableOptimizer and not sweepInit
    sweepInit := true
    rr = sweepRrMin
    while rr <= sweepRrMax + 0.0001
        risk = sweepRiskMin
        while risk <= sweepRiskMax
            array.push(comboRR, rr)
            array.push(comboRiskCap, risk)
            array.push(comboActive, false)
            array.push(comboIsLong, false)
            array.push(comboStop, na)
            array.push(comboTarget, na)
            array.push(comboEntryBar, 0)
            array.push(comboRiskTicks, 0)
            array.push(comboWins, 0)
            array.push(comboLosses, 0)
            array.push(comboGrossProfit, 0.0)
            array.push(comboGrossLoss, 0.0)
            risk += sweepRiskStep
        rr += sweepRrStep
    comboCount := array.size(comboRR)

f_openCombo(i, isLong, entryPx, natTicks) =>
    if not array.get(comboActive, i)
        cap = array.get(comboRiskCap, i)
        if natTicks >= 1 and natTicks <= cap
            rr       = array.get(comboRR, i)
            stopPx   = isLong ? entryPx - natTicks * tickSize : entryPx + natTicks * tickSize
            targetPx = isLong ? entryPx + natTicks * rr * tickSize : entryPx - natTicks * rr * tickSize
            array.set(comboActive, i, true)
            array.set(comboIsLong, i, isLong)
            array.set(comboStop, i, stopPx)
            array.set(comboTarget, i, targetPx)
            array.set(comboEntryBar, i, bar_index)
            array.set(comboRiskTicks, i, natTicks)

f_manageCombo(i) =>
    if array.get(comboActive, i) and bar_index > array.get(comboEntryBar, i)
        isLong   = array.get(comboIsLong, i)
        stopPx   = array.get(comboStop, i)
        targetPx = array.get(comboTarget, i)
        hitStop   = isLong ? low <= stopPx   : high >= stopPx
        hitTarget = isLong ? high >= targetPx : low <= targetPx
        if hitStop or hitTarget
            won   = hitTarget and not hitStop
            riskT = array.get(comboRiskTicks, i)
            rr    = array.get(comboRR, i)
            if won
                array.set(comboWins, i, array.get(comboWins, i) + 1)
                array.set(comboGrossProfit, i, array.get(comboGrossProfit, i) + riskT * rr)
            else
                array.set(comboLosses, i, array.get(comboLosses, i) + 1)
                array.set(comboGrossLoss, i, array.get(comboGrossLoss, i) + riskT)
            array.set(comboActive, i, false)

// ---- Signal detection --------------------------------------------------------
// A flip is only actionable once the flipping candle has actually closed,
// otherwise the signal repaints on every tick of the live bar.
isBullishPrev = close[1] > open[1]
isBearishPrev = close[1] < open[1]
isBullishNow  = close > open
isBearishNow  = close < open

withinLookback = not useLookbackStart or time >= lookbackStart

shortFlip = takeShorts and barstate.isconfirmed and withinLookback and isBullishPrev and isBearishNow
longFlip  = takeLongs  and barstate.isconfirmed and withinLookback and isBearishPrev and isBullishNow

bool shortTaken = false
bool longTaken  = false

// Reference-candle risk distance is shared by the live setup and every combo in
// the optimizer sweep — only the risk cap and R:R decide what happens with it.
int shortNaturalTicks = na
int longNaturalTicks  = na

if shortFlip
    shortNaturalTicks := int(math.round((high[stopLookback] - close) / tickSize))

if longFlip
    longNaturalTicks := int(math.round((close - low[stopLookback]) / tickSize))

// Every qualifying flip opens its own trade — no gating on other trades already
// running, so several can be in flight at once, same as in the screenshot.
if shortFlip
    riskOk = shortNaturalTicks >= 1 and shortNaturalTicks <= maxRiskTicksInput

    if riskOk
        riskT    = shortNaturalTicks
        entryPx  = close
        stopPx   = entryPx + riskT * tickSize
        targetPx = entryPx - riskT * rewardRatioInput * tickSize

        rBox  = box.new(bar_index, stopPx, bar_index, entryPx, border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 85))
        gBox  = box.new(bar_index, entryPx, bar_index, targetPx, border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 85))
        eLine = line.new(bar_index, entryPx, bar_index, entryPx, color = color.new(color.gray, 20), style = line.style_dashed)

        array.push(liveActive, true)
        array.push(liveIsLong, false)
        array.push(liveStop, stopPx)
        array.push(liveTarget, targetPx)
        array.push(liveEntryBar, bar_index)
        array.push(liveRiskTicks, riskT)
        array.push(liveRiskBox, rBox)
        array.push(liveRewardBox, gBox)
        array.push(liveEntryLine, eLine)

        shortTaken := true

        label.new(bar_index, stopPx, text = "SHORT @ " + str.tostring(entryPx) + "\nrisk " + str.tostring(riskT) + "t (1:" + str.tostring(rewardRatioInput) + ")", style = label.style_label_down, color = color.new(color.red, 70), textcolor = color.white, size = size.small)
    else if showSkippedLabels
        skipText = shortNaturalTicks < 1 ? "no trade\n(invalid stop)" : "no trade\n(>" + str.tostring(maxRiskTicksInput) + " ticks)"
        label.new(bar_index, high, text = skipText, style = label.style_label_down, color = color.new(color.gray, 60), textcolor = color.white, size = size.tiny)

if longFlip
    riskOk = longNaturalTicks >= 1 and longNaturalTicks <= maxRiskTicksInput

    if riskOk
        riskT    = longNaturalTicks
        entryPx  = close
        stopPx   = entryPx - riskT * tickSize
        targetPx = entryPx + riskT * rewardRatioInput * tickSize

        rBox  = box.new(bar_index, entryPx, bar_index, stopPx, border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 85))
        gBox  = box.new(bar_index, targetPx, bar_index, entryPx, border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 85))
        eLine = line.new(bar_index, entryPx, bar_index, entryPx, color = color.new(color.gray, 20), style = line.style_dashed)

        array.push(liveActive, true)
        array.push(liveIsLong, true)
        array.push(liveStop, stopPx)
        array.push(liveTarget, targetPx)
        array.push(liveEntryBar, bar_index)
        array.push(liveRiskTicks, riskT)
        array.push(liveRiskBox, rBox)
        array.push(liveRewardBox, gBox)
        array.push(liveEntryLine, eLine)

        longTaken := true

        label.new(bar_index, stopPx, text = "LONG @ " + str.tostring(entryPx) + "\nrisk " + str.tostring(riskT) + "t (1:" + str.tostring(rewardRatioInput) + ")", style = label.style_label_up, color = color.new(color.red, 70), textcolor = color.white, size = size.small)
    else if showSkippedLabels
        skipText = longNaturalTicks < 1 ? "no trade\n(invalid stop)" : "no trade\n(>" + str.tostring(maxRiskTicksInput) + " ticks)"
        label.new(bar_index, low, text = skipText, style = label.style_label_up, color = color.new(color.gray, 60), textcolor = color.white, size = size.tiny)

if enableOptimizer and comboCount > 0
    if shortFlip
        for i = 0 to comboCount - 1
            f_openCombo(i, false, close, shortNaturalTicks)
    if longFlip
        for i = 0 to comboCount - 1
            f_openCombo(i, true, close, longNaturalTicks)
    for i = 0 to comboCount - 1
        f_manageCombo(i)

// ---- Live trade management (every currently open trade, every bar) ----------
liveCount = array.size(liveActive)
if liveCount > 0
    for i = 0 to liveCount - 1
        if array.get(liveActive, i)
            isLong   = array.get(liveIsLong, i)
            stopPx   = array.get(liveStop, i)
            targetPx = array.get(liveTarget, i)
            box.set_right(array.get(liveRiskBox, i), bar_index)
            box.set_right(array.get(liveRewardBox, i), bar_index)
            line.set_x2(array.get(liveEntryLine, i), bar_index)

            entryBar = array.get(liveEntryBar, i)
            if bar_index > entryBar
                hitStop   = isLong ? low <= stopPx   : high >= stopPx
                hitTarget = isLong ? high >= targetPx : low <= targetPx

                if hitStop or hitTarget
                    // If both levels are inside the same bar's range there's no way to
                    // know which traded first intrabar — assume the stop, the worse case.
                    won   = hitTarget and not hitStop
                    riskT = array.get(liveRiskTicks, i)

                    if won
                        winTicks          = int(math.round(riskT * rewardRatioInput))
                        totalWins        += 1
                        netTicks         += winTicks
                        grossProfitTicks += winTicks
                        currentLossStreak := 0
                        if showWinLabels
                            label.new(bar_index, targetPx, text = "WON +" + str.tostring(winTicks) + " ticks", style = isLong ? label.style_label_up : label.style_label_down, color = color.new(color.green, 10), textcolor = color.white, size = size.normal)
                    else
                        totalLosses       += 1
                        netTicks          -= riskT
                        grossLossTicks    += riskT
                        currentLossStreak += 1
                        maxLossStreak     := math.max(maxLossStreak, currentLossStreak)
                        if showLossLabels
                            label.new(bar_index, stopPx, text = "LOST -" + str.tostring(riskT) + " ticks", style = isLong ? label.style_label_down : label.style_label_up, color = color.new(color.red, 10), textcolor = color.white, size = size.normal)

                    array.set(liveActive, i, false)

// ---- Stats table (live setup) -------------------------------------------------
if showStatsTable and barstate.islast
    var table statsTable = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 20), border_color = color.gray, border_width = 1)
    totalTrades  = totalWins + totalLosses
    winRate      = totalTrades > 0 ? (totalWins / totalTrades) * 100 : 0.0
    profitFactor = grossLossTicks > 0 ? grossProfitTicks / grossLossTicks : na
    table.cell(statsTable, 0, 0, "Wins",          text_color = color.white)
    table.cell(statsTable, 1, 0, str.tostring(totalWins), text_color = color.green)
    table.cell(statsTable, 0, 1, "Losses",        text_color = color.white)
    table.cell(statsTable, 1, 1, str.tostring(totalLosses), text_color = color.red)
    table.cell(statsTable, 0, 2, "Win rate",      text_color = color.white)
    table.cell(statsTable, 1, 2, str.tostring(winRate, "#.#") + "%", text_color = color.white)
    table.cell(statsTable, 0, 3, "Net ticks",     text_color = color.white)
    table.cell(statsTable, 1, 3, str.tostring(netTicks), text_color = netTicks >= 0 ? color.green : color.red)
    table.cell(statsTable, 0, 4, "Profit factor", text_color = color.white)
    table.cell(statsTable, 1, 4, na(profitFactor) ? "n/a" : str.tostring(profitFactor, "#.##"), text_color = na(profitFactor) ? color.gray : (profitFactor >= 1 ? color.green : color.red))
    table.cell(statsTable, 0, 5, "Max losing streak", text_color = color.white)
    table.cell(statsTable, 1, 5, str.tostring(maxLossStreak), text_color = color.red)
    sinceTime = useLookbackStart ? math.max(startTime, lookbackStart) : startTime
    table.cell(statsTable, 0, 6, "Since",         text_color = color.white)
    table.cell(statsTable, 1, 6, str.format_time(sinceTime, "yyyy-MM-dd"), text_color = color.white)

// ---- Optimizer results table ---------------------------------------------------
if enableOptimizer and barstate.islast and comboCount > 0
    var table optTable = table.new(position.bottom_right, 2, 6, bgcolor = color.new(color.black, 20), border_color = color.gray, border_width = 1)

    bestIndex = -1
    bestPF    = -1.0
    for i = 0 to comboCount - 1
        trades = array.get(comboWins, i) + array.get(comboLosses, i)
        if trades >= minTradesInput
            gp = array.get(comboGrossProfit, i)
            gl = array.get(comboGrossLoss, i)
            pf = gl > 0 ? gp / gl : (gp > 0 ? 999.0 : 0.0)
            if pf > bestPF
                bestPF    := pf
                bestIndex := i

    table.cell(optTable, 0, 0, "Best Setup", text_color = color.yellow)
    table.cell(optTable, 1, 0, "(by profit factor)", text_color = color.yellow)

    if bestIndex >= 0
        bw   = array.get(comboWins, bestIndex)
        bl   = array.get(comboLosses, bestIndex)
        bt   = bw + bl
        bwr  = bt > 0 ? bw / bt * 100 : 0.0
        brr  = array.get(comboRR, bestIndex)
        brsk = array.get(comboRiskCap, bestIndex)
        table.cell(optTable, 0, 1, "R:R",          text_color = color.white)
        table.cell(optTable, 1, 1, "1:" + str.tostring(brr, "#.##"), text_color = color.white)
        table.cell(optTable, 0, 2, "Max Risk",     text_color = color.white)
        table.cell(optTable, 1, 2, str.tostring(brsk) + "t", text_color = color.white)
        table.cell(optTable, 0, 3, "Profit factor",text_color = color.white)
        table.cell(optTable, 1, 3, str.tostring(bestPF, "#.##"), text_color = color.green)
        table.cell(optTable, 0, 4, "Win rate",     text_color = color.white)
        table.cell(optTable, 1, 4, str.tostring(bwr, "#.#") + "%", text_color = color.white)
        table.cell(optTable, 0, 5, "Trades",       text_color = color.white)
        table.cell(optTable, 1, 5, str.tostring(bt), text_color = color.white)
    else
        table.cell(optTable, 0, 1, "not enough qualifying trades yet", text_color = color.gray)
        table.cell(optTable, 1, 1, "", text_color = color.gray)

alertcondition(shortTaken, title = "Bullish→Bearish reversal", message = "Bullish→Bearish reversal: short setup triggered")
alertcondition(longTaken,  title = "Bearish→Bullish reversal", message = "Bearish→Bullish reversal: long setup triggered")
