//@version=6
indicator("Candle Reversal — Fixed R:R Trade Detector", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ---- Inputs ----------------------------------------------------------------
maxRiskTicksInput = input.int(124, title = "Max Risk (ticks) — skip trade if exceeded", minval = 1)
rewardRatioInput  = input.float(1.0, title = "Reward:Risk Ratio (1.0 = 1:1, 2.0 = 1:2, etc.)", minval = 0.1, step = 0.1)
takeShorts        = input.bool(true, title = "Take bullish→bearish (short) signals")
takeLongs         = input.bool(true, title = "Take bearish→bullish (long) signals")
showWinLabels     = input.bool(true, title = "Show winning trade labels")
showLossLabels    = input.bool(true, title = "Show losing trade labels")
showSkippedLabels = input.bool(true, title = "Show skipped-signal labels")
showStatsTable    = input.bool(true, title = "Show stats table")

tickSize = syminfo.mintick

// ---- Persistent trade state -------------------------------------------------
var bool  tradeActive   = false
var bool  tradeIsLong   = false
var float entryPrice    = na
var float stopPrice     = na
var float targetPrice   = na
var int   riskTicks     = na
var int   entryBarIndex = na
var box   riskBox       = na
var box   rewardBox     = na
var line  entryLine     = na

var int   totalWins   = 0
var int   totalLosses = 0
var int   netTicks    = 0

// A flip is only actionable once the flipping candle has actually closed,
// otherwise the signal repaints on every tick of the live bar.
isBullishPrev = close[1] > open[1]
isBearishPrev = close[1] < open[1]
isBullishNow  = close > open
isBearishNow  = close < open

shortCandidate = takeShorts and barstate.isconfirmed and not tradeActive and isBullishPrev and isBearishNow
longCandidate  = takeLongs  and barstate.isconfirmed and not tradeActive and isBearishPrev and isBullishNow

bool shortTaken = false
bool longTaken  = false

if shortCandidate
    priorHigh = high[1]
    candEntry = close

    // The stop only belongs above the prior candle's high if the signal candle's
    // own wick hasn't already poked up through it — otherwise the stop would have
    // been hit before/at entry, so the setup is invalid rather than clamped.
    wickOk       = high < priorHigh
    naturalTicks = int(math.round((priorHigh - candEntry) / tickSize))
    riskOk       = naturalTicks >= 1 and naturalTicks <= maxRiskTicksInput

    if wickOk and riskOk
        entryPrice    := candEntry
        riskTicks     := naturalTicks
        stopPrice     := entryPrice + riskTicks * tickSize
        targetPrice   := entryPrice - riskTicks * rewardRatioInput * tickSize
        entryBarIndex := bar_index
        tradeActive   := true
        tradeIsLong   := false
        shortTaken    := true

        riskBox   := box.new(bar_index, stopPrice, bar_index, entryPrice, border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 85))
        rewardBox := box.new(bar_index, entryPrice, bar_index, targetPrice, border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 85))
        entryLine := line.new(bar_index, entryPrice, bar_index, entryPrice, color = color.new(color.gray, 20), style = line.style_dashed)

        label.new(bar_index, stopPrice, text = "SHORT @ " + str.tostring(entryPrice) + "\nrisk " + str.tostring(riskTicks) + "t (1:" + str.tostring(rewardRatioInput) + ")", style = label.style_label_down, color = color.new(color.red, 70), textcolor = color.white, size = size.small)
    else if showSkippedLabels
        skipText = not wickOk ? "no trade\n(wick broke stop)" : "no trade\n(>" + str.tostring(maxRiskTicksInput) + " ticks)"
        label.new(bar_index, high, text = skipText, style = label.style_label_down, color = color.new(color.gray, 60), textcolor = color.white, size = size.tiny)

if longCandidate
    priorLow  = low[1]
    candEntry = close

    // Symmetric guard: the stop only belongs below the prior candle's low if the
    // signal candle's own wick hasn't already poked down through it.
    wickOk       = low > priorLow
    naturalTicks = int(math.round((candEntry - priorLow) / tickSize))
    riskOk       = naturalTicks >= 1 and naturalTicks <= maxRiskTicksInput

    if wickOk and riskOk
        entryPrice    := candEntry
        riskTicks     := naturalTicks
        stopPrice     := entryPrice - riskTicks * tickSize
        targetPrice   := entryPrice + riskTicks * rewardRatioInput * tickSize
        entryBarIndex := bar_index
        tradeActive   := true
        tradeIsLong   := true
        longTaken     := true

        riskBox   := box.new(bar_index, entryPrice, bar_index, stopPrice, border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 85))
        rewardBox := box.new(bar_index, targetPrice, bar_index, entryPrice, border_color = color.new(color.green, 40), bgcolor = color.new(color.green, 85))
        entryLine := line.new(bar_index, entryPrice, bar_index, entryPrice, color = color.new(color.gray, 20), style = line.style_dashed)

        label.new(bar_index, stopPrice, text = "LONG @ " + str.tostring(entryPrice) + "\nrisk " + str.tostring(riskTicks) + "t (1:" + str.tostring(rewardRatioInput) + ")", style = label.style_label_up, color = color.new(color.red, 70), textcolor = color.white, size = size.small)
    else if showSkippedLabels
        skipText = not wickOk ? "no trade\n(wick broke stop)" : "no trade\n(>" + str.tostring(maxRiskTicksInput) + " ticks)"
        label.new(bar_index, low, text = skipText, style = label.style_label_up, color = color.new(color.gray, 60), textcolor = color.white, size = size.tiny)

if tradeActive
    box.set_right(riskBox, bar_index)
    box.set_right(rewardBox, bar_index)
    line.set_x2(entryLine, bar_index)

    if bar_index > entryBarIndex
        hitStop   = tradeIsLong ? low <= stopPrice   : high >= stopPrice
        hitTarget = tradeIsLong ? high >= targetPrice : low <= targetPrice

        if hitStop or hitTarget
            // If both levels are inside the same bar's range there's no way to
            // know which traded first intrabar — assume the stop, the worse case.
            won = hitTarget and not hitStop

            if won
                totalWins += 1
                netTicks  += int(math.round(riskTicks * rewardRatioInput))
                if showWinLabels
                    label.new(bar_index, targetPrice, text = "WON +" + str.tostring(int(math.round(riskTicks * rewardRatioInput))) + " ticks", style = tradeIsLong ? label.style_label_up : label.style_label_down, color = color.new(color.green, 10), textcolor = color.white, size = size.normal)
            else
                totalLosses += 1
                netTicks    -= riskTicks
                if showLossLabels
                    label.new(bar_index, stopPrice, text = "LOST -" + str.tostring(riskTicks) + " ticks", style = tradeIsLong ? label.style_label_down : label.style_label_up, color = color.new(color.red, 10), textcolor = color.white, size = size.normal)

            tradeActive := false

// ---- Stats table -------------------------------------------------------------
if showStatsTable and barstate.islast
    var table statsTable = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 20), border_color = color.gray, border_width = 1)
    totalTrades = totalWins + totalLosses
    winRate     = totalTrades > 0 ? (totalWins / totalTrades) * 100 : 0.0
    table.cell(statsTable, 0, 0, "Wins",     text_color = color.white)
    table.cell(statsTable, 1, 0, str.tostring(totalWins), text_color = color.green)
    table.cell(statsTable, 0, 1, "Losses",   text_color = color.white)
    table.cell(statsTable, 1, 1, str.tostring(totalLosses), text_color = color.red)
    table.cell(statsTable, 0, 2, "Win rate", text_color = color.white)
    table.cell(statsTable, 1, 2, str.tostring(winRate, "#.#") + "%", text_color = color.white)
    table.cell(statsTable, 0, 3, "Net ticks", text_color = color.white)
    table.cell(statsTable, 1, 3, str.tostring(netTicks), text_color = netTicks >= 0 ? color.green : color.red)

alertcondition(shortTaken, title = "Bullish→Bearish reversal", message = "Bullish→Bearish reversal: short setup triggered")
alertcondition(longTaken,  title = "Bearish→Bullish reversal", message = "Bearish→Bullish reversal: long setup triggered")
