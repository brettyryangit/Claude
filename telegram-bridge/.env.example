# Claude Code Telegram Bridge - Environment Configuration
# Copy this file to .env and fill in your values

# Required
TELEGRAM_BOT_TOKEN=your-bot-token-here
ALLOWED_USER_IDS=your-telegram-user-id
TELEGRAM_GROUP_ID=your-group-chat-id
WORKING_DIR=/path/to/your/project

# Optional
CLAUDE_TIMEOUT=300
CLAUDE_MODEL=

# Voice transcription (pick one or leave WHISPER_PROVIDER empty to disable)
WHISPER_PROVIDER=
# WHISPER_PROVIDER=local       # Apple Silicon, requires: pip install mlx-whisper
# WHISPER_PROVIDER=openai      # OpenAI Whisper API
# WHISPER_PROVIDER=groq        # Groq (free tier available, very fast)

WHISPER_MODEL=mlx-community/whisper-small-mlx
# WHISPER_API_KEY=sk-...       # Required for openai/groq providers
